# VITE_SITE_URL: Production canonical site URL (no trailing slash).
# Replace with your real domain before deploying so canonicals, Open Graph tags,
# sitemap.xml, and robots.txt point to your live domain.
VITE_SITE_URL="https://YOUR-DOMAIN.com"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
